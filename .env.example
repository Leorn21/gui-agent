# Anthropic API (billed separately from a Claude Pro subscription)
ANTHROPIC_API_KEY=

# Planner
GUI_AGENT_MODEL=claude-haiku-5-5
GUI_AGENT_EFFORT=low
# Zoom context around the chosen cell, in cells per side (1 = previous behavior)
GUI_AGENT_ZOOM_MARGIN=0.5

# Agent runtime
GUI_AGENT_MAX_STEPS=20
GUI_AGENT_SAFETY_HOTKEY=ctrl+alt+q
GUI_AGENT_RESUME_HOTKEY=ctrl+alt+r
